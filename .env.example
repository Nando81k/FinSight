# FinSight Environment Variables
# Copy this file to .env and update the values

# Server Configuration
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# Database
DB_URL=postgres://postgres:postgres@localhost:5433/finsight

# Security
SESSION_SECRET=your-super-secret-session-key-change-this-in-production
ENCRYPTION_KEY=your-32-byte-hex-encryption-key-for-api-credentials

# External APIs
COINGECKO_BASE=https://api.coingecko.com/api/v3
ALPHAVANTAGE_KEY=your-alpha-vantage-api-key
OPENAI_KEY=your-openai-api-key

# Coinbase API (for live integration)
COINBASE_API_URL=https://api.coinbase.com/api/v3/brokerage

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100